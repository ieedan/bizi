{
  "$comment": "Shared inputs for the conformance cases. Task maps are keyed in config order, which both clients must preserve.",
  "taskMaps": {
    "empty": {},
    "flat": {
      "build": { "command": "pnpm build" },
      "test": { "command": "pnpm test" }
    },
    "monorepo": {
      "dev": { "tasks": { "api": {}, "web": {} } },
      "dev:api": { "command": "pnpm --filter api dev", "color": "cyan" },
      "dev:web": { "command": "pnpm --filter web dev", "color": "#f0a" },
      "check": {
        "command": "pnpm check",
        "tasks": { "lint": {}, "types": {} }
      },
      "check:lint": { "command": "pnpm lint", "color": "not-a-color" },
      "check:types": { "command": "pnpm tsc" },
      "build": { "command": "pnpm build" }
    },
    "deep": {
      "a": { "tasks": { "b": {} } },
      "a:b": { "tasks": { "c": {} } },
      "a:b:c": { "command": "echo c" },
      "z": { "command": "echo z" }
    },
    "ghostChild": {
      "dev": { "tasks": { "missing": {} } }
    },
    "groupOnly": {
      "dev": { "tasks": { "api": {} } },
      "dev:api": { "command": "pnpm --filter api dev" }
    }
  },
