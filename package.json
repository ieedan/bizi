{
  "name": "bizi-monorepo",
  "repository": "https://github.com/ieedan/bizi",
  "homepage": "https://getbizi.dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "generate:clients": "pnpm --filter './packages/client-*' generate",
    "test": "bun run scripts/test.ts",
    "test:ts": "cd apps/tui && TZ=UTC bun test tests/",
    "test:rs": "TZ=UTC cargo test -p bizi-tui",
    "test:e2e": "TZ=UTC bun test tests/e2e/",
    "test:e2e:rs": "cargo build -p bizi-tui && TZ=UTC BIZI_CLIENT=rust bun test tests/e2e/",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/bun": "^1.3.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "ultracite": "7.2.0"
  }
}
