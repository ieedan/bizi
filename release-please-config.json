{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "tui",
      "components": [
        "tui",
        "tui-darwin-arm64",
        "tui-darwin-x64",
        "tui-win32-x64",
        "tui-win32-arm64"
      ]
    },
    {
      "type": "linked-versions",
      "groupName": "tui-rs",
      "components": [
        "tui-rs-crate",
        "tui-rs",
        "tui-rs-darwin-arm64",
        "tui-rs-darwin-x64",
        "tui-rs-win32-x64",
        "tui-rs-win32-arm64"
      ]
    }
  ],
  "packages": {
    "crates/bizi-api": {
      "release-type": "rust",
      "component": "api",
      "initial-version": "0.1.0"
    },
    "crates/bizi-server": {
      "release-type": "rust",
      "component": "server"
    },
    "packages/client-js": {
      "release-type": "node",
      "component": "client"
    },
    "apps/tui": {
      "release-type": "node",
      "component": "tui"
    },
    "apps/tui/packages/bizi-darwin-arm64": {
      "release-type": "node",
      "component": "tui-darwin-arm64"
    },
    "apps/tui/packages/bizi-darwin-x64": {
      "release-type": "node",
      "component": "tui-darwin-x64"
    },
    "apps/tui/packages/bizi-win32-x64": {
      "release-type": "node",
      "component": "tui-win32-x64"
    },
    "apps/tui/packages/bizi-win32-arm64": {
      "release-type": "node",
      "component": "tui-win32-arm64"
    },
    "crates/bizi-tui": {
      "release-type": "rust",
      "component": "tui-rs-crate",
      "initial-version": "0.1.0"
    },
    "apps/tui-rs": {
      "release-type": "node",
      "component": "tui-rs",
      "initial-version": "0.1.0"
    },
    "apps/tui-rs/packages/bizi-rs-darwin-arm64": {
      "release-type": "node",
      "component": "tui-rs-darwin-arm64",
      "initial-version": "0.1.0"
    },
    "apps/tui-rs/packages/bizi-rs-darwin-x64": {
      "release-type": "node",
      "component": "tui-rs-darwin-x64",
      "initial-version": "0.1.0"
    },
    "apps/tui-rs/packages/bizi-rs-win32-x64": {
      "release-type": "node",
      "component": "tui-rs-win32-x64",
      "initial-version": "0.1.0"
    },
    "apps/tui-rs/packages/bizi-rs-win32-arm64": {
      "release-type": "node",
      "component": "tui-rs-win32-arm64",
      "initial-version": "0.1.0"
    }
  }
}
